{
  "name": "ngx-ai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-ai",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-ai --watch --configuration development",
    "test": "ng test ngx-ai --watch=false",
    "format:check": "prettier --check \"projects/**/*.{ts,html,json,md}\"",
    "format": "prettier --write \"projects/**/*.{ts,html,json,md}\"",
    "pack:lib": "npm run build && cd dist/ngx-ai && npm pack"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
